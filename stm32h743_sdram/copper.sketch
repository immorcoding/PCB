# Copper region sketch of the STM32H743 + SDRAM board (LAY-1, PWR-1, 3, 7, 8). Read by scripts/cu_sketch.py.
# This text is the source of truth for every pour; after a zone is dragged in KiCad it is read back
# into this file before anything else runs (PWR-7).
#
# Coordinates: mm from the board's top-left corner, x right, y down (board 85 x 75).
# State: stop 3. Only the two BGAs are placed. Every region below says where its block goes; parts are
# then placed around the regions, and the outlines are tightened in the power-and-copper stage.
#
# Floor plan the regions assume (starting values, SPEC 8.2):
#   top edge     audio jacks x 8-31, SWD x 36-45, microSD x 47-63
#   left edge    RJ45 y 26-45 with the PHY to its right; QSPI flash below it
#   centre       MCU body x 35-45, y 32-42; SDRAM to its right at (57, 37), rotation 0, body x 53-61, y 30.5-43.5 (line-order sketch, 2026-11-21)
#   right        CAN terminal on the right edge near the top; 3.3 V buck below it; 12 V input, 5 V buck
#                and the DC jack lower down
#   bottom edge  LCD FPC x 29-56, debug UART right of it, backlight boost at x 58-70
#   codec        under the audio jacks, x 10-21, y 19-31 (not next to the switchers)

origin 100 100
planes L2 L3 L5
gap 0.5                   # L3: distance between blocks of different nets (PWR-8)
clearance 0.2             # outer layers: local pour to anything else (user to confirm, U33)
minwidth 0.2              # narrowest drawn part (user to confirm, U33)

# ---- ground: L2 and L5 are whole planes, never cut; L1 and L6 are filled with ground where free
region L2_GND GND L2 whole
region L5_GND GND L5 whole
region L1_GND GND L1 whole minwidth=0.3
region L6_GND GND L6 whole minwidth=0.3

# ---- L3, the power plane. +3V3 is everything that is not one of the blocks below.
region L3_3V3 +3V3 L3 whole

# +5V: band down the right side (5 V buck, backlight link, CAN link) and a strip along the top to the
# analog LDO beside the codec (SPEC 5). The strip runs at y 5.5-8.5, between the two rows of locating
# holes of the audio jacks; its leg at x 22-25 comes down between the jacks' hole columns.
region L3_5V +5V L3
  22,5.5  75,5.5  75,26  83.5,26  83.5,66  66,66  66,8.5  25,8.5  25,22  22,22

# +3V3A: under the codec and its analog decoupling only
region L3_3V3A +3V3A L3
  10,19.5  21.5,19.5  21.5,31  10,31

# Block rails behind 0 ohm links (user 2026-11-20). The two BGA blocks are on L3 because their supply
# balls reach the plane through vias under the package; this makes five blocks on L3 instead of
# three (confirmed by the user on 2026-11-21; SPEC sections 1 and 5 updated).
region L3_3V3_MCU +3V3_MCU L3
  34,31  46,31  46,43  34,43
region L3_3V3_SDRAM +3V3_SDRAM L3
  52,29.5  62,29.5  62,44.5  52,44.5

# ---- outer-layer local pours (L1). One per copper-class net of SPEC 5; rectangles for now.
# 12 V input chain, right edge, lower part
region L1_12V_JACK +12V_JACK L1
  70,50  73,50  73,53  70,53
region L1_12V_IN +12V_IN L1
  66.5,50  69.5,50  69.5,53  66.5,53
region L1_12V +12V L1
  67,38  75,38  75,46  67,46
# 5 V buck: switch node kept small, output up to its 0 ohm link
region L1_SW_5V SW_5V L1
  68,33  71,33  71,36  68,36
region L1_5V_REG +5V_REG L1
  72,28  80,28  80,36  72,36
# 3.3 V buck, above the 5 V buck
region L1_SW_3V3 SW_3V3 L1
  68,14  70.5,14  70.5,16.5  68,16.5
region L1_3V3_REG +3V3_REG L1
  71,12  77,12  77,18  71,18
# LDOs beside the codec
region L1_5V_LDO +5V_LDO L1
  26,21  29,21  29,24  26,24
region L1_3V3_LDO +3V3_LDO L1
  26,26  29,26  29,29  26,29
region L1_1V8 +1V8 L1
  22.5,26  25.5,26  25.5,29  22.5,29
region L1_3V3_AUD +3V3_AUD L1
  10,20  13,20  13,23  10,23
# MCU analog supply at the VDDA / VREF+ balls (R1, P1: bottom-left corner of the MCU)
region L1_VDDA_MCU VDDA_MCU L1
  31,40  33.5,40  33.5,44  31,44
# Ethernet PHY, between the RJ45 and the MCU
region L1_VDDA_PHY VDDA_PHY L1
  23,33  27,33  27,36  23,36
region L1_3V3_PHY +3V3_PHY L1
  23,37.5  27,37.5  27,40  23,40
# the remaining block rails
region L1_3V3_QSPI +3V3_QSPI L1
  12,49  15,49  15,52  12,52
region L1_3V3_LCD +3V3_LCD L1
  38,60  41,60  41,63  38,63
region L1_3V3_SD +3V3_SD L1
  50,19  53,19  53,22  50,22
region L1_3V3_CAN +3V3_CAN L1
  70,22  72.5,22  72.5,24  70,24
region L1_5V_CAN +5V_CAN L1
  73.5,22  76,22  76,24  73.5,24
# backlight boost at the bottom, right of the FPC
region L1_5V_BL +5V_BL L1
  60,58  63,58  63,61  60,61
region L1_SW_BL SW_BL L1
  64,58  66,58  66,60  64,60
region L1_LED_A LED_A L1
  60,62  64,62  64,64.5  60,64.5
