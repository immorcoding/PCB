{
  "_": "SPEC.md section 9. Read by scripts/len_rules.py. Members are rule conditions; lo / hi are mm relative to the reference. SDRAM data is matched inside each byte lane by the static skew rules sdram_lane0..3 of the rule file, not here.",
  "groups": [
    {"rule": "qspi_window",
     "members": "A.NetName == 'QSPI_BK1_IO*'",
     "ref": ["QSPI_CLK"], "lo": -5, "hi": 5, "cap": 30},
    {"rule": "sdmmc_window",
     "members": "A.NetClass == 'SDMMC' && A.NetName != 'SDMMC1_CK'",
     "ref": ["SDMMC1_CK"], "lo": 0, "hi": 5},
    {"rule": "rmii_rx_min",
     "members": "A.NetName == 'RMII_RXD*' || A.NetName == 'RMII_CRS_DV'",
     "ref": ["RMII_REF_CLK"], "lo": 0, "cap": 60}
  ],
  "sums": [
    {"name": "sdclk_total", "nets": ["FMC_SDCLK", "FMC_SDCLK_R"], "max": 60},
    {"name": "rmii_refclk_plus_longest_txd", "nets": ["RMII_REF_CLK"], "plus_longest_of": ["RMII_TXD0", "RMII_TXD1"], "max": 100}
  ]
}
