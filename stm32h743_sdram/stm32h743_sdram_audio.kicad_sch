		)
		(uuid "bc9bc2f9-2180-5899-bfe2-5b20c8a0123f")
	)
	(text "Jacks J601, J602: T = tip = left, R = ring = right, S = sleeve = GND (Same Sky terminals 2, 3, 1)."
		(exclude_from_sim no)
		(at 15.24 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ca99175c-4e10-5976-9f13-c46232224f77")
	)
	(text "HPLCOM, HPRCOM, line outputs, LINE1 inputs, MICBIAS: not used, left open (powered down = high impedance)."
		(exclude_from_sim no)
