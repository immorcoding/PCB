		)
		(uuid "3dfeade9-ebc9-5b19-8c8f-ba4ef123c9d3")
	)
	(text "Supply order (p.91): IOVDD (+3V3), then AVDD / DRVDD (+3V3A), then DVDD (+1V8); set by the enable chain on the power page."
		(exclude_from_sim no)
		(at 15.24 256.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5b84a36b-575b-5944-9717-b7f25889fa67")
	)
	(text "R603 holds the codec in reset until firmware drives CODEC_NRST (PG9) high; a hard reset after power-up is required (p.22)."
		(exclude_from_sim no)
		(at 15.24 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6a600a05-2b17-5c0e-b95b-452b868c37c2")
	)
	(text "I2C4 pull-ups"
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6f13383c-4207-5ac3-84dc-bba26a1176bf")
	)
	(text "Headphone output, AC-coupled"
		(exclude_from_sim no)
		(at 248.92 33.02 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7a86f668-5d67-547f-b4e9-8122a055770c")
	)
	(text "C613, C614: tantalum, + to the codec (output common mode 1.35 V). 220 uF: 45 Hz into 16 ohm, 23 Hz into 32 ohm."
		(exclude_from_sim no)
		(at 15.24 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8c05a770-22d3-591d-8d9a-919497f234e0")
	)
	(text "Codec"
		(exclude_from_sim no)
		(at 86.36 33.02 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ab5e4b82-c9bb-5208-8487-7e34e6e1e200")
	)
	(text "R601, R602: the only pull-ups on I2C4 (codec 0x18 here, touch panel 0x38 on the LCD page)."
		(exclude_from_sim no)
		(at 15.24 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b7c4e033-9b2a-5840-be80-28cfd91519df")
	)
	(text "Audio: TLV320AIC3104 codec (I2S slave on SAI1, I2C4 address 0x18), headphone out, line in"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
