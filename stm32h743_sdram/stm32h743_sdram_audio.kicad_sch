		(uuid "db1bc8ca-0dae-5c4c-9221-f8d25135860c")
	)
	(text "U601 pins: TI SLAS510G p.5-6. Thermal pad (33) to DRVSS = GND. I2C address fixed 0x18, no strap pins. AVDD and DRVDD: same net."
		(exclude_from_sim no)
