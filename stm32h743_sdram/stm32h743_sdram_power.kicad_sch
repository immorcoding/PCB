	(text "+12V to +5V, 2 A: LMR51420XF (500 kHz, forced PWM)"
		(exclude_from_sim no)
		(at 15.24 88.9 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "14187c1b-a6a2-5f6c-9ae4-fcf55202209a")
	)
	(text "C105-C107: about 54 uF at 5 V bias; the worst overshoot (inductor energy at current limit) stays near 5.5 V, the TPS62A02 abs max is 6.5 V.  SW_5V, +12V, +5V: copper regions."
		(exclude_from_sim no)
		(at 15.24 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2c9c37f0-fe09-56a7-970d-fca95b9211fe")
	)
	(text "+5V to +3V3A (codec AVDD / DRVDD) and +3V3 to +1V8 (codec DVDD): TPS7A20, 300 mA"
		(exclude_from_sim no)
		(at 15.24 215.9 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3214c13e-40c8-5583-b5f6-665812916c1a")
	)
	(text "Power area, next to the codec,"
		(exclude_from_sim no)
		(at 330.2 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "32cb1f75-6b49-56fe-a3dc-e2745e94d9dd")
	)
	(text "Power-up order for the codec: +3V3 (IOVDD), then +3V3A, then +1V8.  Power-down order is not controlled.  U103 dissipates about 0.11 W."
		(exclude_from_sim no)
		(at 15.24 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "61cb254c-b585-548f-88b4-f4831499b66c")
	)
	(text "Enable chain: +5V -> EN_3V3, +3V3 -> EN_3V3A, +3V3A -> EN_1V8, each through 10 k so the 1.0 mm pad can be pulled to GND on the bench."
		(exclude_from_sim no)
		(at 15.24 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6e0de000-2c36-5747-83d2-7e3ed3295f4e")
	)
	(text "+5V to +3V3, 2 A: TPS62A02 (2.4 MHz); enabled by +5V"
		(exclude_from_sim no)
		(at 15.24 152.4 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7b07729d-3a2b-5c1f-80e1-9ad994f0e971")
	)
	(text "next to MCU and SDRAM."
		(exclude_from_sim no)
		(at 330.2 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8719e48f-d2e4-5dbc-a9db-df16c592976c")
	)
	(text "VOUT = 0.6 V x (1 + R105 / R106) = 3.315 V.  VIN abs max 6.5 V, recommended 5.5 V max.  PG (open drain) is not used."
		(exclude_from_sim no)
		(at 15.24 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8cf63c40-c380-5a2c-ad9a-51c4b8468a7d")
	)
	(text "D101 holds VGS under 13 V (limit 20 V).  D102 SMBJ18A: stand-off 18 V, clamps 29.2 V at 20.5 A (LMR51420 abs max 38 V, Q101 40 V).  No series links in any rail."
		(exclude_from_sim no)
		(at 15.24 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "96555b6f-f940-5e37-8302-c6f8893648c8")
	)
	(text "GND test loops, GND flag"
