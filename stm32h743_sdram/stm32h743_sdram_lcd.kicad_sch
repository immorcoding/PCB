	(text "The connector takes a 0.5 mm pitch FPC, 20.5 mm wide, 0.3 mm thick, contacts on either side (Innolux drawing p.20 matches). The Rocktech -CT672B tail is 0.8 mm pitch (outline p.16) and does not fit; only its pin order is used."
		(exclude_from_sim no)
		(at 15.24 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "02861c39-6dca-533c-84ca-ee420a0f8b82")
	)
	(text "R705: DISP low = standby while PG14 floats in reset. Power-on order (Innolux p.7): VDD, LTDC signals within 100 ms, DISP high, backlight at least 160 ms after DISP; reverse order for power-off."
		(exclude_from_sim no)
