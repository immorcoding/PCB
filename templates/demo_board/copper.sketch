# Copper region sketch of the demo board (LAY-1, PWR-1, 3, 7, 8), read by Tools.KiCadDesignTools.copper.cu_sketch.
# This text is the source of every pour; a zone dragged in KiCad is read back into it before anything else runs.
# Coordinates: mm from the board's top-left corner, x right, y down (board 40 x 30). Edges 0 / 45 / 90 degrees only.
#
# Floor plan (place.toml): MCU body x 9-19, y 9-19 (rule area 8-20); SDRAM body x 25-33, y 9.5-22.5 (rule area
# 24-34, 8.5-23.5); crystal west of the MCU; +3V3 header J1 on the left edge (y 21-23.5), UART header J2 on the bottom
# edge (x 14-21.6, y 26.6).

origin 100 100
planes L2 L5
gap 0.5                   # L5: distance between the +3V3 block and the ground around it (PWR-8)
clearance 0.2             # outer layers: local pour to anything else
minwidth 0.2              # narrowest drawn part

# ---- ground: L2 the whole ground plane; L1 and L6 filled with ground where free (no pour inside the BGA rule areas
# on L1: the placement's no-pour keep-outs); L5 ground outside the +3V3 block
region L2_GND GND L2 whole
region L1_GND GND L1 whole minwidth=0.3
region L6_GND GND L6 whole minwidth=0.3
region L5_GND GND L5 whole

# ---- L5, the power plane: one +3V3 block under both BGAs and their bottom decoupling, a tongue west to J1 pin 1 and
# one south to J2 pin 4 (the through-hole pins join the block directly)
region L5_3V3 +3V3 L5
  7.5,7.5  34.5,7.5  34.5,24  22.8,24  22.8,28.6  20.3,28.6  20.3,22.6  0.5,22.6  0.5,19.4  7.5,19.4

# ---- L1, the one local pour: J1 pin 1 and the bulk capacitor C9's +3V3 pad
region L1_3V3 +3V3 L1
  0.5,19.4  5.3,19.4  5.3,22.6  0.5,22.6
