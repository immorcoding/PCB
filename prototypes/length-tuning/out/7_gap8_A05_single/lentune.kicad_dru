(version 1)
# PROTOTYPE (issue 15): rule file of the length-tuning test board. Profile C (docs/rule-profiles/C-bga-065.md).
# Taken from the copper-regions prototype (issue 16), which took it from the abandoned RK3568 board.
# Later rules override earlier ones.
# ANY syntax error silently disables this WHOLE file (kicad-cli reports
# nothing). Known traps: angles are unitless ("135", not "135deg");
# min_resolved_spokes takes a bare number ("2", not "(min 2)"); no '#' comment after a rule line.
# scripts/dru_canary.py proves the file is loaded; len_table.py proves the length rule matches nets.
#
# Outside the BGA rule areas: via 0.45 / 0.2 minimum, clearance 0.127 (net class), signal width >= 0.1016.
# Inside the rule areas BGA_MCU, BGA_SDRAM (package outline + 1 mm):
#   track 0.09, clearance >= 0.09, via >= 0.3 / 0.15, annular ring >= 0.075.

# --- Track width (AD Width rules, min / preferred / max) ---
(rule "signal_width"
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.1016mm) (opt 0.2032mm) (max 0.8128mm)))

(rule "pwr_width"
  (condition "A.Type == 'Track' && A.NetClass == 'PWR'")
  (constraint track_width (min 0.1524mm) (opt 0.3048mm) (max 2.54mm)))

(rule "xtal_width"
  (condition "A.Type == 'Track' && A.NetClass == 'XTAL'")
  (constraint track_width (min 0.254mm) (opt 0.254mm) (max 0.254mm)))

# --- Holes and vias (AD HoleSize 10-120 mil; RoutingVias hole 12-30, dia 16-50 mil) ---
(rule "hole_range"
  (constraint hole_size (min 0.15mm) (max 3.3mm)))

(rule "via_size"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.2mm) (max 0.762mm))
  (constraint via_diameter (min 0.45mm) (max 1.27mm))
  (constraint annular_width (min 0.125mm)))

# --- BGA fan-out areas: finer tracks, clearance and vias ---
(rule "bga_via"
  (condition "A.Type == 'Via' && (A.intersectsArea('BGA_MCU') || A.intersectsArea('BGA_SDRAM'))")
  (constraint hole_size (min 0.15mm) (max 0.762mm))
  (constraint via_diameter (min 0.3mm) (max 1.27mm))
  (constraint annular_width (min 0.075mm)))

# A track that touches a rule area (also one that crosses its edge) may be 0.09.
(rule "bga_width"
  (condition "A.Type == 'Track' && (A.intersectsArea('BGA_MCU') || A.intersectsArea('BGA_SDRAM'))")
  (constraint track_width (min 0.09mm) (opt 0.09mm) (max 2.54mm)))

# A signal track that lies wholly inside a rule area must be exactly 0.09 (research for issue 14, section 6.3).
(rule "bga_width_inside"
  (condition "A.Type == 'Track' && A.NetClass != 'PWR' && (A.enclosedByArea('BGA_MCU') || A.enclosedByArea('BGA_SDRAM'))")
  (constraint track_width (min 0.09mm) (opt 0.09mm) (max 0.09mm)))

# Finding of the copper-regions prototype (issue 16): without the two Type tests a pour that merely
# overlaps a rule area is filled at 0.09 mm clearance everywhere on the board.
(rule "bga_clearance"
  (condition "A.Type != 'Zone' && B.Type != 'Zone' && (A.intersectsArea('BGA_MCU') || A.intersectsArea('BGA_SDRAM'))")
  (constraint clearance (min 0.09mm)))

# --- Corners: no 90-degree or acute bends (interior angle >= 135) ---
# 134 rather than 135: KiCad measures some exact 45-degree turns as 134.9999 and flags them.
(rule "corner_angle"
  (constraint track_angle (min 134)))

# --- Shortest segment ---
(rule "min_segment"
  (condition "A.Type == 'Track'")
  (constraint track_segment_length (min 0.1mm)))

# --- Pour connection: thermal relief for through-hole, solid for SMD ---
(rule "tht_thermal"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint zone_connection thermal_reliefs)
  (constraint thermal_spoke_width (min 0.254mm))
  (constraint thermal_relief_gap (min 0.254mm))
  (constraint min_resolved_spokes 2))

(rule "smd_solid"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD'")
  (constraint zone_connection solid))

# --- SDRAM group (issue 12): each net at most 60 mm, at most 3 vias (target 2). ---
# The +-2.5 mm window against SDCLK is a generated rule; it is added by the tuning step, not here.
(rule "sdram_len_max"
  (condition "A.NetName == '/FMC_*'")
  (constraint length (max 60mm)))

(rule "sdram_via_max"
  (condition "A.NetName == '/FMC_*'")
  (constraint via_count (max 3)))

# --- generated by meander.py (issue 14): every /FMC_* net within +-2.5 mm of /FMC_SDCLK, L = 16.6778 mm ---
# It comes after sdram_len_max and replaces it for these nets (a later length rule wins); max is far below 60 mm.
(rule "sdram_window"
  (condition "A.NetName == '/FMC_*'")
  (constraint length (min 14.1778mm) (opt 16.6778mm) (max 19.1778mm)))
