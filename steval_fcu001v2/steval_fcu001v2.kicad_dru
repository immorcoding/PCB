(version 1)
# Custom DRC rules migrated from E:\AD25workspace\pcb_rules\common.RUL
# Later rules override earlier ones.
# ANY syntax error silently disables this WHOLE file (kicad-cli reports
# nothing). Known traps: angles are unitless ("135", not "135deg");
# min_resolved_spokes takes a bare number ("2", not "(min 2)").
# After editing, run DRC and confirm a corner_angle hit appears.
# Full rationale and AD mapping: docs/design-rules.md
#
# PROJECT OVERRIDES for JLCPCB 4-layer, JLC04161H-3313, 1.6 mm (differs from templates/common):
#   signal_width min 0.1016 -> 0.127 (kept at the 2-layer value; JLC multilayer allows less)
#   via_size     hole min 0.3048 -> 0.2, diameter min 0.4064 -> 0.45. Vias are 0.6 / 0.3
#     everywhere except the MCU pin fan-out, where 0.45 / 0.2 is the largest that fits
#     between 0.5 mm-pitch pins (JLC multilayer limit; confirm the price tier when ordering).
#   USB2 net class (USB_D+/-, USB_CONN_D+/-): 0.15 mm, pair gap 0.15 mm, skew <= 0.5 mm
#     -> rules usb2_width / usb2_gap / usb2_skew. About 88 ohm differential on F.Cu over
#     In1.Cu by the IPC-2141 formula, assuming 0.0994 mm prepreg with Er 4.1 (stackup
#     figures not confirmed with JLC's calculator; USB here is full speed only).
#   hole_range   max 3.048 -> 3.3 (M3 mounting holes are 3.2 mm)
#   PWR also takes *VCAP*, *MOTOR?_N and *M?_OUT (patterns in the .kicad_pro)
#
# Layer use and routing conventions: not agreed yet, to be added here before routing.

# --- Track width (AD Width rules, min / preferred / max) ---
(rule "signal_width"
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.127mm) (opt 0.2032mm) (max 0.8128mm)))

(rule "pwr_width"
  (condition "A.Type == 'Track' && A.NetClass == 'PWR'")
  (constraint track_width (min 0.1524mm) (opt 0.3048mm) (max 2.54mm)))

(rule "usb2_width"
  (condition "A.Type == 'Track' && A.NetClass == 'USB2'")
  (constraint track_width (min 0.127mm) (opt 0.15mm) (max 0.2mm)))

(rule "xtal_width"
  (condition "A.Type == 'Track' && A.NetClass == 'XTAL'")
  (constraint track_width (min 0.254mm) (opt 0.254mm) (max 0.254mm)))

# --- Holes and vias (AD HoleSize 10-120 mil; RoutingVias hole 12-30, dia 16-50 mil) ---
(rule "hole_range"
  (constraint hole_size (min 0.2mm) (max 3.3mm)))

(rule "via_size"
  (condition "A.Type == 'Via'")
  (constraint hole_size (min 0.2mm) (max 0.762mm))
  (constraint via_diameter (min 0.45mm) (max 1.27mm)))

# --- Corners: no 90-degree or acute bends (interior angle >= 135) ---
# Also reports 90-degree T-junctions; triage those case by case.
# 134 rather than 135: KiCad measures some exact 45-degree turns as 134.9999 and flags them.
(rule "corner_angle"
  (constraint track_angle (min 134)))

# --- Pour connection: thermal relief for through-hole, solid for SMD ---
(rule "tht_thermal"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint zone_connection thermal_reliefs)
  (constraint thermal_spoke_width (min 0.254mm))
  (constraint thermal_relief_gap (min 0.254mm))
  (constraint min_resolved_spokes 2))

(rule "smd_solid"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD'")
  (constraint zone_connection solid))

# --- Matched length (AD MatchedLengths USB3.0, tolerance 5 mil) ---
# Width/gap of diff pairs are NOT set here: compute them from the fab's
# stackup before layout, then add a net class per interface.
(rule "usb3_skew"
  (condition "A.NetClass == 'USB3'")
  (constraint skew (max 0.127mm)))

# --- USB 2.0 full speed pair: loose skew, gap kept tight. The 0.8 mm maximum covers the
# 1.4 mm where the pair splits round U3's ground pad (0.77 mm) and the connector breakout. ---
# within_diff_pairs: compare D+ with D- of the same pair. Without it the MCU-side pair
# (about 16 mm) is compared with the connector-side pair (about 2 mm).
(rule "usb2_skew"
  (condition "A.NetClass == 'USB2'")
  (constraint skew (max 0.5mm) (within_diff_pairs)))

(rule "usb2_gap"
  (condition "A.NetClass == 'USB2' && A.inDiffPair('*')")
  (constraint diff_pair_gap (min 0.127mm) (opt 0.15mm) (max 0.8mm)))
